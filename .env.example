# Copy to .env for local development, and set the same variable in your host's
# build settings (Vercel/Netlify/etc) for production.
#
# Vite inlines VITE_* variables AT BUILD TIME. Setting this on the server that
# serves the finished files does nothing — it has to be present when `vite
# build` runs, or the bundle still carries the localhost fallback.

VITE_API_URL=http://localhost:5000/api
